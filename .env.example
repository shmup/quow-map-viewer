# copy to .env and point it at your unzipped MUSHclient.zip
# real environment variables win over anything set here

# required — the pngs, and _quowmap_database.db alongside them
QUOW_MAPS_DIR=~/MUSHclient/quow_plugins/maps

# only if you keep the database somewhere else
#QUOW_DB_PATH=~/MUSHclient/quow_plugins/maps/_quowmap_database.db

# where your client writes {"room_identifier": "..."}
DISCWORLD_STORE_PATH=../../store.json

# optional, tintin only — room notes and bookmark labels
DISCWORLD_MAP_PATH=../../data/discworld-quow.map
DISCWORLD_BOOKMARKS_PATH=../../data/bookmarks.tin
